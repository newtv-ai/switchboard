{
  "name": "@switchboard/core",
  "version": "0.1.0",
  "description": "PTY relay, session manager, and ring buffer. Agent-agnostic.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@switchboard/sdk": "0.1.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  },
  "tsup": {
    "entry": ["src/index.ts"],
    "format": ["esm"],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "node18",
    "external": ["node-pty"]
  }
}
